{
  "dataset": "D4",
  "data_root": "data/100-driver",
  "backbone": "mobilenet_v2",
  "image_size": 224,
  "epochs": 30,
  "batch_size": 128,
  "workers": 8,
  "seed": 42,
  "pretrained": true,
  "optimizer": "adamw",
  "lr": 0.002,
  "weight_decay": 0.0001,
  "warmup_epochs": 3,
  "milestones": [10, 20],
  "lr_gamma": 0.2,
  "use_kd": true,
  "use_grl": true,
  "temperature": 4.0,
  "beta1": 0.7,
  "beta1_decay_start": 10,
  "beta1_decay_step": 0.04,
  "beta1_minimum": 0.1,
  "beta2": 0.2,
  "grl_mode": "legacy",
  "teacher_logits": null,
  "output": "runs/D4"
}
